[Unit]
Description=Byte Server Panel Minecraft Server Control Panel
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/mc-server-panel
ExecStart=/usr/bin/node %h/.local/opt/mc-server-panel/src/main.js
Restart=on-failure
RestartSec=3
Environment=MC_PANEL_HOST=127.0.0.1
Environment=MC_PANEL_PORT=8765
Environment=MC_PANEL_DATA_DIR=%h/.local/share/mc-server-panel
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=default.target
